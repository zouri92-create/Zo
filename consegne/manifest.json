{
  "manifest_version": 3,
  "name": "Giro Consegne",
  "version": "1.2.3",
  "description": "Pianifica i giri dei fattorini: quale consegna dare, orari di arrivo e di rientro.",
  "action": {
    "default_title": "Apri Giro Consegne",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://maps.googleapis.com/*",
    "https://routes.googleapis.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://*.app.cashdesk.nl/*",
    "https://photon.komoot.io/*"
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.app.cashdesk.nl/*"
      ],
      "js": [
        "cashdesk.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}