# Copia questo file come .env e riempi i valori. Il file .env non va mai condiviso o caricato su GitHub.

# Claude (obbligatoria) - console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Immagini AI (facoltativa) - platform.openai.com > API keys
OPENAI_API_KEY=
# MODELLO_IMMAGINI=gpt-image-1
# Qualità delle immagini AI: low, medium (predefinita), high. Più alta = più cara.
# QUALITA_IMMAGINI=medium

# Facebook (facoltativa) - ID della Pagina e token di accesso della Pagina (Page access token)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# FACEBOOK_GRAPH_VERSION=v23.0

# TikTok (facoltativa) - token utente con permesso video.upload
TIKTOK_ACCESS_TOKEN=

# Modelli Claude (facoltativi). Di default tutti usano claude-sonnet-5-5.
# MODELLO_CAPO=claude-opus-5-5
# MODELLO_SPECIALISTI=claude-sonnet-5-5

# --- Google (facoltativo) - per crearli: python collega_google.py (vedi README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Ads: token sviluppatore (Strumenti > Centro API) e ID cliente (le 10 cifre in alto, senza trattini)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Solo se accedi tramite un account amministratore (MCC):
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Analytics 4: ID numerico della proprietà
GA4_PROPERTY_ID=

# Search Console: indirizzo della proprietà, es. https://www.miapizzeria.de/ oppure sc-domain:miapizzeria.de
SEARCH_CONSOLE_SITO=

# Scheda Google (Business Profile): li stampa collega_google.py
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
